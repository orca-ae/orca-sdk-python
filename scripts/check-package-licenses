#!/usr/bin/env python3
# Copyright The Orca Authors
# SPDX-License-Identifier: Apache-2.0
"""Verify license and attribution files in built wheels and source distributions."""

from __future__ import annotations

import sys
import tarfile
import zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LICENSE_FILES = ("LICENSE", "NOTICE", "THIRD_PARTY_NOTICES")


def check_archive(path: Path) -> None:
    if path.name.endswith(".whl"):
        with zipfile.ZipFile(path) as wheel:
            metadata = [name for name in wheel.namelist() if name.endswith(".dist-info/METADATA")]
            if len(metadata) != 1:
                raise ValueError("expected one wheel metadata directory")
            prefix = metadata[0].rsplit("/", 1)[0] + "/licenses/"
            contents = {name: wheel.read(prefix + name) for name in LICENSE_FILES}
    elif path.name.endswith(".tar.gz"):
        with tarfile.open(path) as sdist:
            metadata = [name for name in sdist.getnames() if name.count("/") == 1 and name.endswith("/PKG-INFO")]
            if len(metadata) != 1:
                raise ValueError("expected one source distribution root")
            prefix = metadata[0].rsplit("/", 1)[0] + "/"
            contents = {}
            for name in LICENSE_FILES:
                member = sdist.getmember(prefix + name)
                if not member.isfile():
                    raise ValueError(f"{name} must be a regular file")
                file = sdist.extractfile(member)
                if file is None:
                    raise ValueError(f"cannot read {name}")
                with file:
                    contents[name] = file.read()
    else:
        raise ValueError("expected a .whl or .tar.gz archive")

    for name, data in contents.items():
        if data != (ROOT / name).read_bytes():
            raise ValueError(f"{name} differs from the repository copy")


def main(args: list[str]) -> int:
    if not args:
        print("usage: scripts/check-package-licenses ARCHIVE...", file=sys.stderr)
        return 2
    for arg in args:
        try:
            check_archive(Path(arg))
        except (OSError, KeyError, ValueError, tarfile.TarError, zipfile.BadZipFile) as exc:
            print(f"{arg}: license verification failed: {exc}", file=sys.stderr)
            return 1
        print(f"{arg}: all license and attribution files match")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
