#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# Builds the wheel and sdist and attaches them to an existing GitHub Release.
#
# The release itself is created by release-please (see .github/workflows/create-releases.yml);
# this script only produces and uploads the artifacts. Requires GH_TOKEN in the environment.
: "${TAG:?TAG must be set (e.g. v0.1.0)}"

rm -rf dist
uv build

# --clobber keeps a re-run idempotent after a partially-completed upload.
gh release upload "$TAG" dist/*.whl dist/*.tar.gz --clobber

echo "==> Attached to $TAG:"
ls -1 dist
